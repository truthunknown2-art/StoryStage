{
  "name": "storystage",
  "version": "0.1.0",
  "description": "A directable, deterministic animation production studio.",
  "license": "UNLICENSED",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "pnpm --filter @storystage/render-worker build && pnpm --filter @storystage/asset-worker build && pnpm --filter @storystage/desktop build && pnpm --filter @storystage/studio build",
    "build:desktop": "pnpm --filter @storystage/render-worker build && pnpm --filter @storystage/asset-worker build && pnpm --filter @storystage/desktop build",
    "dev": "pnpm build:desktop && concurrently --kill-others-on-fail --names studio,desktop --prefix-colors cyan,magenta \"pnpm --filter @storystage/studio dev\" \"wait-on http://127.0.0.1:5173 && pnpm --filter @storystage/desktop start\"",
    "dev:web": "pnpm --filter @storystage/studio dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "render:sample": "pnpm --filter @storystage/render-worker render:sample",
    "render:proof": "pnpm --filter @storystage/render-worker render:proof",
    "render:determinism": "pnpm --filter @storystage/render-worker render:determinism",
    "render:audio": "pnpm --filter @storystage/render-worker render:audio",
    "prepare:rook": "tsx scripts/prepare-rook-show-pack.ts",
    "prepare:rook-pilot-review": "tsx scripts/prepare-rook-pilot-review.ts",
    "analyze:sprite-atlases": "tsx scripts/analyze-sprite-atlases.ts",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "verify:privacy": "node scripts/verify-privacy.mjs",
    "verify": "pnpm verify:privacy && pnpm lint && pnpm typecheck && pnpm test",
    "render:production-proof": "pnpm --filter @storystage/render-worker render:production-proof",
    "render:rook-preview": "pnpm --filter @storystage/render-worker render:rook-preview",
    "render:rook-motion-review": "pnpm --filter @storystage/render-worker render:rook-motion-review",
    "render:cv001-creator-locality-proof": "pnpm --filter @storystage/render-worker render:cv001-creator-locality-proof",
    "proof:cv001-creator": "node scripts/proof-cv001-creator.mjs",
    "proof:cv002-draft": "node scripts/proof-cv002-draft.mjs",
    "proof:cv002-creator-shell": "node scripts/proof-cv002-creator-shell.mjs",
    "proof:cv002-template": "node scripts/proof-cv002-template.mjs",
    "render:kids-showcase-proof": "pnpm --filter @storystage/render-worker render:kids-showcase-proof",
    "render:director-alpha-proof": "pnpm --filter @storystage/render-worker render:director-alpha-proof"
  },
  "devDependencies": {
    "@playwright/cli": "0.1.17",
    "@remotion/eslint-config-flat": "4.0.490",
    "@types/node": "24.10.1",
    "axe-core": "4.10.3",
    "concurrently": "9.2.1",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vitest": "4.1.10",
    "wait-on": "9.0.3"
  }
}
